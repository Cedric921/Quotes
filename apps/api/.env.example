# ===========================================
# Focus API Environment Variables
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Priority: DATABASE_URL (if postgres) > SUPABASE > SQLite (fallback)

# Option 1: Full PostgreSQL connection string (recommended for production)
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Option 2: Supabase credentials (auto-constructs connection)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_DB_PASSWORD=your-database-password

# Option 3: SQLite fallback (default for development)
SQLITE_DATABASE=database.sqlite

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ===========================================
# STRIPE CONFIGURATION (Required for subscriptions)
# ===========================================
# Get your keys from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (starts with whsec_)
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# STRIPE PRICE IDS (Configure in Stripe Dashboard)
# ===========================================
# Create Products and Prices in Stripe Dashboard:
# https://dashboard.stripe.com/products

# Monthly subscription price ID (e.g., price_1234567890abcdef)
STRIPE_MONTHLY_PRICE_ID=price_monthly_placeholder

# Yearly subscription price ID (e.g., price_0987654321fedcba)
STRIPE_YEARLY_PRICE_ID=price_yearly_placeholder

# ===========================================
# FIREBASE (for push notifications)
# ===========================================
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ===========================================
# CLOUDINARY (for image uploads)
# ===========================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret