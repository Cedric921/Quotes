# ===========================================
# Focus API Environment Variables
# ===========================================

# ===========================================
# DATABASE CONFIGURATION (Supabase)
# ===========================================
# Use Session Pooler connection from Supabase (required for IPv4 compatibility)
# Go to: Supabase Dashboard > Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.xxx:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ===========================================
# STRIPE CONFIGURATION (Required for subscriptions)
# ===========================================
# Get your keys from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (starts with whsec_)
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# STRIPE PRICE IDS (Configure in Stripe Dashboard)
# ===========================================
# Create Products and Prices in Stripe Dashboard:
# https://dashboard.stripe.com/products

# Monthly subscription price ID (e.g., price_1234567890abcdef)
STRIPE_MONTHLY_PRICE_ID=price_monthly_placeholder

# Yearly subscription price ID (e.g., price_0987654321fedcba)
STRIPE_YEARLY_PRICE_ID=price_yearly_placeholder

# ===========================================
# FIREBASE (for push notifications)
# ===========================================
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ===========================================
# CLOUDINARY (for image uploads)
# ===========================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# EMAIL / BREVO (mot de passe oublié)
# ===========================================
# Deux routes possibles, dans cet ordre de priorité.
#
# 1) API HTTP Brevo — recommandé, et obligatoire sur Render :
#    l'hébergeur bloque les ports SMTP (25, 465, 587) sur les instances
#    gratuites. Le symptôme n'est pas une erreur mais un timeout de deux
#    minutes par message. L'API passe en HTTPS sur le 443, que rien ne bloque.
#    Clé : https://app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key
#    L'adresse doit être un expéditeur VÉRIFIÉ chez Brevo (Senders & IP),
#    sinon l'API répond « sender not valid ».
MAIL_FROM=Focus <noreply@votre-domaine.com>

# 2) SMTP — repli, valable partout où les ports sont ouverts (VPS, instance
#    payante). Ignoré dès que BREVO_API_KEY est présent.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
#
# Sans aucune des deux, l'API ne plante pas : le code de réinitialisation est
# écrit dans les logs et /health indique mail: not_configured.

# ===========================================
# DEEPL TRANSLATION API
# ===========================================
# Get your API key from: https://www.deepl.com/pro-api
# Free tier: 500,000 characters/month
DEEPL_API_KEY=your-deepl-api-key-here
# Set to 'true' if using DeepL Pro (paid account)
DEEPL_API_PRO=false
# RevenueCat Webhook Secret
# Generate with: openssl rand -base64 32
# Must match the Bearer token configured in RevenueCat Dashboard
# Project Settings > Integrations > Webhooks
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
