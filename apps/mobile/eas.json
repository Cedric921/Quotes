{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://focus-sml2.onrender.com",
        "APP_NAME": "Focus Dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://focus-sml2.onrender.com"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "API_URL": "https://focus-sml2.onrender.com"
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "API_URL": "https://focus-sml2.onrender.com",
        "IOS_BUNDLE_ID": "com.mindset.focus",
        "ANDROID_PACKAGE": "com.mindset.focus",
        "APPLE_TEAM_ID": "XA9AGYDNGM"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "focusmindsetapp@gmail.com",
        "ascAppId": "6761561417",
        "appleTeamId": "XA9AGYDNGM"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
