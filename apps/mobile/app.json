{
  "$schema": "https://docs.expo.dev/versions/latest/config/app/",
  "_comment": "Dynamic values (name, version, owner, projectId, bundleId, package) are loaded from .env via app.config.js",
  "expo": {
    "scheme": "focus-quotes",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "1",
      "icon": "./assets/images/app-icon-all.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette application utilise la camera pour vous permettre de prendre une photo de profil.",
        "NSPhotoLibraryUsageDescription": "Cette application accede a votre galerie pour vous permettre de choisir une photo de profil.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.mindset.focus",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mindset.focus.widget"
        ]
      }
    },
    "android": {
      "icon": "./assets/images/app-icon-android-legacy.png",
      "splash": {
        "image": "./assets/images/splash-logo-android-universal.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#667eea",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accede a vos photos pour vous permettre de choisir une photo de profil.",
          "cameraPermission": "L'application accede a votre camera pour vous permettre de prendre une photo de profil."
        }
      ],
      "expo-font"
    ]
  }
}
