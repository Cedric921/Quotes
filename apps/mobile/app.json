{
  "expo": {
    "name": "Focus",
    "slug": "focus-quotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-all.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "focus-quotes",
    "splash": {
      "image": "./assets/images/splash-logo-all.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.focus.quotes",
      "buildNumber": "1",
      "icon": "./assets/images/app-icon-all.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette application utilise la caméra pour vous permettre de prendre une photo de profil.",
        "NSPhotoLibraryUsageDescription": "Cette application accède à votre galerie pour vous permettre de choisir une photo de profil.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-android-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "icon": "./assets/images/app-icon-android-legacy.png",
      "splash": {
        "image": "./assets/images/splash-logo-android-universal.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "package": "com.focus.quotes",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#667eea",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour vous permettre de choisir une photo de profil.",
          "cameraPermission": "L'application accède à votre caméra pour vous permettre de prendre une photo de profil."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "17f0365b-1f51-4a37-b269-591ea43caffe"
      }
    },
    "owner": "cedric921",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/17f0365b-1f51-4a37-b269-591ea43caffe"
    }
  }
}
