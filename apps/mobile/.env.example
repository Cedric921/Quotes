# ===========================================
# Focus Mobile App Environment Variables
# ===========================================
# Copy this file to .env and update the values
# cp .env.example .env

# ===========================================
# EXPO / EAS CONFIGURATION
# ===========================================
# Get your project ID from: https://expo.dev/accounts/[owner]/projects/[project]
# Or run: eas project:info
EAS_PROJECT_ID=035730c8-2c0a-4ade-9b34-f902e800ebfa

# EAS Owner account name
EAS_OWNER=focus-application

# App slug (must match EAS project slug)
APP_SLUG=focus-quotes-app

# App name displayed to users
APP_NAME=Focus

# App version
APP_VERSION=1.0.0

# iOS Bundle Identifier
IOS_BUNDLE_ID=com.focus.quotes

# Android Package Name
ANDROID_PACKAGE=com.focus.quotes

# Apple Team ID (for iOS builds)
APPLE_TEAM_ID=XXXXXXXXXX

# ===========================================
# API CONFIGURATION
# ===========================================
# For physical devices: Update the IP to match your computer's IP address
# To find your IP: ifconfig | grep "inet " | grep -v 127.0.0.1
# For iOS simulator: Use http://localhost:3001
# For Android emulator: Use http://10.0.2.2:3001
# For production: Use https://your-api-domain.com
API_URL=http://localhost:3001

# Request timeout in milliseconds
API_TIMEOUT=30000

# ===========================================
# STRIPE CONFIGURATION (for payments)
# ===========================================
# Get your publishable key from: https://dashboard.stripe.com/apikeys
# Note: Only use the PUBLISHABLE key on the client side, never the SECRET key!

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ===========================================
# APP BEHAVIOR CONFIGURATION
# ===========================================

# Number of quotes per page
QUOTES_PER_PAGE=10

# Pagination threshold for infinite scroll (0-1)
PAGINATION_THRESHOLD=0.5
