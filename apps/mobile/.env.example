# API Configuration
# For physical devices: Update the IP to match your computer's IP address
# To find your IP: ifconfig | grep "inet " | grep -v 127.0.0.1
# For web/emulator: Use http://localhost:3001
API_URL=http://192.168.1.66:3001

# Request timeout in milliseconds
API_TIMEOUT=30000

# App Configuration
QUOTES_PER_PAGE=10
PAGINATION_THRESHOLD=0.5

